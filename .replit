modules = ["java-graalvm22.3", "nodejs-20"]
[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/backend && JAVA_HOME=$(dirname $(dirname $(which java))) ./gradlew bootRun -x test > /tmp/backend.log 2>&1 & cd /home/runner/workspace/frontend && exec npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 23636
externalPort = 3000

[nix]
channel = "stable-25_05"
packages = ["jdk21", "gradle"]
